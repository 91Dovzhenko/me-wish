# Скопируйте в .env и заполните. Файл .env не коммитится.
# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…) или Legacy anon key
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
# Вход через Telegram-бота (ТЗ 003-f2). Имя бота без @ — публичное. Токен бота сюда НЕ кладётся:
# он только в секретах Supabase (TELEGRAM_BOT_TOKEN), как и секрет вебхука (TELEGRAM_WEBHOOK_SECRET).
VITE_TELEGRAM_BOT_NAME=me_wish_bot
